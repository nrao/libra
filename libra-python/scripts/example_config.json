{
    "_comment": "LibRA Python SLURM Pipeline Configuration",
    "_comment_usage": "Use with: python libra_python_slurm_clean.py --config this_file.json",
    "_comment_required": "These parameters are required:",
    
    "imagename": "roadrunner_test",
    "vis": "/path/to/your/visibility.ms", 
    "cfcache": "/path/to/your/cf_cache/libra.cf",
    "imsize": [2048, 2048],
    "cell": [1.0, 1.0],
    "phasecenter": "J2000 12h30m00.0s -30d00m00.0s",
    "reffreq": "3.0GHz",
    
    "_comment_optional": "These parameters are optional with defaults:",
    
    "mode": "gridding",
    "stokes": "I",
    "field": "*",
    "spw": "*",
    
    "_comment_roadrunner": "Roadrunner (gridding) parameters:",
    "datacolumn": "data",
    "wprojplanes": 1,
    "weighting": "briggs",
    "robust": 0.5,
    "gridder": "awphpg",
    "wbawp": true,
    "uvrange": "",
    "usepointing": false,
    "normalize": false,
    "pbcor": true,
    "conjbeams": true,
    "pblimit": 0.2,
    "pointingoffsetsigdev": [300.0, 300.0],
    "spwdataiter": true,
    
    "_comment_hummbee": "Hummbee (deconvolution/restoration) parameters:",
    "deconvolver": "hogbom",
    "scales": [],
    "largestscale": -1.0,
    "fusedthreshold": 0.0,
    "nterms": 1,
    "gain": 0.1,
    "threshold": 0.0001,
    "nsigma": 0.0,
    "cycleniter": 1000,
    "cyclefactor": 1.0,
    "mask": "",
    "specmode": "mfs",
    
    "_comment_dale": "Dale (PSF/model processing) parameters:",
    "normtype": "flatnoise",
    
    "_comment_coyote": "Coyote (CF filling) parameters:",
    "telescopename": "EVLA",
    "nw": 1,
    "wbawp_coyote": true,
    "psterm": true,
    "aterm": true,
    "mtype": "Mueller",
    "pa": 0.0,
    "dpa": 5.0,
    "cfbuffersize": 512,
    "cfoversampling": 20,
    "cflist": []
}