# syntax=docker/dockerfile:1
# Base container — CPU-only build (no CUDA).
FROM docker.io/rockylinux:8 AS base

LABEL Author=pjaganna@nrao.edu
LABEL Version=v1.0.0-base
LABEL Description="LibRA Base Container (CPU-only) with system dependencies"

COPY scripts/container_recipes/CI/readline.pc /usr/lib64/pkgconfig/

# Install system packages and development tools
RUN dnf -y clean all \
    && dnf -y install epel-release \
    && dnf install -y dnf-plugins-core \
    && dnf config-manager --set-enabled powertools \
    && dnf -y install git cmake gcc-c++ gcc-gfortran flex bison tar curl bzip2 make which findutils \
    && dnf -y install {readline,ncurses,blas,lapack,cfitsio,fftw,wcslib,gsl,eigen3,openmpi,python38}-devel \
    && dnf clean all

ENV PATH=/data/libra/install/bin:$PATH
ENV LD_LIBRARY_PATH=/data/libra/install/lib:$LD_LIBRARY_PATH
ENV LIBRA_PATH=/data/libra

# Source tree comes from the workflow's actions/checkout (with submodules)
# via the build context — no in-build git clone, no token needed.
COPY . /data/libra

CMD ["/bin/bash"]
