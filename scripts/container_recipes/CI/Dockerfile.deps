# syntax=docker/dockerfile:1
# Dependencies container — builds all LibRA external dependencies.
# CPU-only build: Kokkos runs on OpenMP/Serial, no CUDA backend.
ARG BASE_IMAGE=ardgnrao/libra-base:cpu
FROM ${BASE_IMAGE} AS dependencies

LABEL Description="LibRA Dependencies Container (CPU-only)"

ARG nproc=8

WORKDIR /data/libra

RUN mkdir -p build && cd build \
    && cmake \
         -DApps_BUILD_TESTS=ON \
         -DLIBRA_ENABLE_CUDA_BACKEND=OFF \
         ..

RUN cd build \
    && make -j${nproc} \
        Kokkos \
        FFTW_source \
        FFTW_double \
        FFTW_float \
        Hpg \
        Casacore \
        Parafeed \
        Pybind11 \
        GTest

CMD ["/bin/bash"]
