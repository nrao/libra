# syntax=docker/dockerfile:1
# Deployment container -- CPU-only. Not part of the base->deps->components->tests
# chain: this installs the prebuilt libra-python wheel (built by the build-wheel
# CI job) into a plain Jupyter notebook image, with a small sample dataset for
# a first-run smoke test + demo imaging pass. No compilers, no LibRA source
# tree, no dev headers.
#
# Standalone deployment target (e.g. a single AWS instance) -- not run under
# JupyterHub, so no docker-stacks base image / singleuser scaffolding needed.
# Built directly on Ubuntu 24.04 instead of quay.io/jupyter/base-notebook to
# avoid the ~1-1.5GB conda/mamba stack that image carries just to run
# JupyterLab.
FROM ubuntu:24.04

LABEL Description="LibRA deployment container (CPU-only) -- wheel install + sample data + demo notebook"

ARG NB_USER=jovyan
ARG NB_UID=1000
ARG NB_GID=100
ENV NB_USER=${NB_USER}

RUN (getent passwd ${NB_UID} | cut -d: -f1 | xargs -r userdel --remove) \
    && (getent group ${NB_GID} || groupadd --gid ${NB_GID} --non-unique users) \
    && useradd --create-home --shell /bin/bash --uid ${NB_UID} --gid ${NB_GID} ${NB_USER}

# Runtime shared-lib deps for the bundled LibRA/Casacore/HPG .so files that
# aren't already vendored into the wheel's _libs/ (verified via ldd against
# the actual built wheel, not guessed):
#   blas/lapack   - casacore scimath
#   gfortran      - casacore/mirlib Fortran routines
#   gsl           - casacore coordinates/measures
#   readline/ncurses (tinfo) - casacore table shell/logging
#   cfitsio, wcslib - casacore fits/coordinates
#   curl          - casacore data download utilities (measuresdata-update etc.)
#   zlib, bzip2   - table compression
# python3/python3-pip/python3-venv - notebook server interpreter (stock 24.04
# Python, separate from the cp38 wheel venv below)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libblas3 liblapack3 libgfortran5 libgsl27 \
    libreadline8 libtinfo6 \
    libcfitsio10t64 libwcs8 \
    libcurl4 zlib1g libbz2-1.0 \
    wget ca-certificates \
    python3 python3-pip python3-venv \
    software-properties-common gnupg \
    && add-apt-repository -y ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y --no-install-recommends \
    python3.8 python3.8-venv python3.8-distutils \
    && apt-get purge -y software-properties-common gnupg \
    && apt-get autoremove -y \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# --- Notebook server ---
# Plain JupyterLab in its own venv (system Python 3.12), independent of the
# LibRA cp38 venv below. No tini/start-notebook.sh/JupyterHub singleuser
# scaffolding -- this container is launched standalone, not under a Hub.
RUN python3 -m venv /opt/jupyter_venv \
    && /opt/jupyter_venv/bin/pip install --no-cache-dir --upgrade pip \
    && /opt/jupyter_venv/bin/pip install --no-cache-dir jupyterlab \
    && ln -s /opt/jupyter_venv/bin/jupyter /usr/local/bin/jupyter

USER ${NB_UID}

# --- Python 3.8 interpreter for the LibRA wheel ---
# TEMPORARY: build-wheel (container-build.yml) compiles the pybind11
# extension inside ardgnrao/libra-deps:cpu (Rocky 8), whose only stock
# Python is 3.8 -- hence the cp38 wheel tag. Ubuntu noble (this image's
# base) dropped python3.8 from its own repos, so it's pulled from the
# deadsnakes PPA instead. This is a stopgap: the real fix is building the
# wheel against a current Python in libra-deps so this whole interpreter
# stays unnecessary -- tracked as follow-up work, not a permanent fixture.

# --- LibRA wheel ---
# Built by the build-wheel CI job (container-build.yml), CPU-only
# (LIBRA_ENABLE_CUDA=OFF). Passed in as a build context file, not fetched --
# the deploy job downloads the build-wheel artifact first. Installed into
# its own cp38 venv and registered as a separate Jupyter kernel -- it can't
# share the notebook server's default (newer) Python environment.
COPY --chown=${NB_UID}:${NB_GID} libra-0.1.0-cp38-cp38-linux_x86_64.whl /tmp/
RUN python3.8 -m venv /home/${NB_USER}/.libra_venv \
    && /home/${NB_USER}/.libra_venv/bin/pip install --no-cache-dir --upgrade pip \
    && /home/${NB_USER}/.libra_venv/bin/pip install --no-cache-dir --no-deps /tmp/libra-0.1.0-cp38-cp38-linux_x86_64.whl \
    && /home/${NB_USER}/.libra_venv/bin/pip install --no-cache-dir numpy matplotlib ipykernel \
    && /home/${NB_USER}/.libra_venv/bin/python -m ipykernel install --user \
       --name libra-cp38 --display-name "LibRA (Python 3.8)" \
    && rm /tmp/libra-0.1.0-cp38-cp38-linux_x86_64.whl

# Sample MS fetched at startup by entrypoint.sh, not baked into the image.
COPY --chown=${NB_UID}:${NB_GID} entrypoint.sh /home/${NB_USER}/entrypoint.sh
RUN mkdir -p /home/${NB_USER}/sample_data \
    && chmod +x /home/${NB_USER}/entrypoint.sh

COPY --chown=${NB_UID}:${NB_GID} demo.ipynb /home/${NB_USER}/demo.ipynb

WORKDIR /home/${NB_USER}

EXPOSE 8888

# JUPYTER_TOKEN and CONTEXT_PATH are set at deploy time via the Helm chart
# (helm-libra), sourced from an encrypted values file -- never baked into
# the image or left blank.
ENTRYPOINT ["./entrypoint.sh"]
CMD ["sh", "-c", "jupyter lab --ip=0.0.0.0 --port=8888 --no-browser \
     --ServerApp.token=\"${JUPYTER_TOKEN}\" \
     --ServerApp.base_url=\"${CONTEXT_PATH:-/}\" \
     --ServerApp.allow_origin='*'"]
